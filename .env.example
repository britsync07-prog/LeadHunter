# ==============================================================================
# LeadHunter — Production Environment Variables
# Copy this file to '.env' and fill in the values before starting.
# ==============================================================================

# Core Application Settings
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
PUBLIC_URL=https://leadhunter.uk

# Security & Authentication
# Generate random strings for these in production
SESSION_SECRET=your_secure_session_secret
TRACKING_HMAC_SECRET=your_secure_tracking_secret

# External API Access (if applicable)
EXTERNAL_API_KEY=your-secure-api-key

# Stripe Integration (Optional - for payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Logging
# levels: error, warn, info, debug
LOG_LEVEL=info
